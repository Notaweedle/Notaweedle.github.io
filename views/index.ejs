<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body>

<%- include('partials/nav') %>

<!-- HERO -->
<section id="hero">
    <p class="hero-eyebrow">Developer &amp; Game Enthusiast</p>
    <h1 class="hero-name">Hi, I'm <%= name %>.<br /><em>I build things.</em></h1>
    <p class="hero-sub">
        CS student with a passion for Python, game development, and making software that actually does something useful.
    </p>
    <div class="hero-cta">
        <a href="#projects" class="btn">See My Work</a>
        <a href="#contact" class="btn-ghost">Get in touch ↗</a>
    </div>
</section>

<div class="divider"></div>

<!-- ABOUT -->
<section id="about">
    <p class="eyebrow reveal">About Me</p>
    <h2 class="sec-title reveal">A bit about who I am</h2>
    <div class="about-layout">
        <div class="about-text reveal">
            <p>I'm a developer who got into code because of games — and never really left. My main language is <strong>Python</strong>, though I'm comfortable in <strong>C# and Java</strong> too, and I've been picking up web dev along the way.</p>
            <p>I like projects that have a real purpose — a scraper that tracks prices, a game engine that actually works, a bot that runs on my own hardware. I learn best by building.</p>
            <p>Outside of coding I'm deep into <strong>RimWorld</strong>, running a local AI setup at home, and slowly working toward a career in game development.</p>
            <div style="margin-top:2rem;"><a href="#contact" class="btn" style="font-size:0.85rem;">Say hello</a></div>
        </div>
        <div class="about-cards reveal">
            <% stats.forEach(stat => { %>
                <div class="about-card">
                    <div class="about-card-num"><%= stat.value %></div>
                    <div class="about-card-label"><%= stat.label %></div>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<div class="divider"></div>

<!-- PROJECTS -->
<section id="projects">
    <p class="eyebrow reveal">Projects</p>
    <h2 class="sec-title reveal">Things I've built</h2>
    <div class="projects-grid reveal">
        <% projects.forEach((proj, i) => { %>
            <div class="proj-card">
                <p class="proj-num">0<%= i + 1 %></p>
                <h3 class="proj-title"><%= proj.title %></h3>
                <p class="proj-desc"><%= proj.desc %></p>
                <div class="tag-row">
                    <% proj.tags.forEach(tag => { %>
                        <span class="tag"><%= tag %></span>
                    <% }) %>
                </div>
            </div>
        <% }) %>
    </div>
</section>

<div class="divider"></div>

<!-- SKILLS -->
<section id="skills">
    <p class="eyebrow reveal">Skills</p>
    <h2 class="sec-title reveal">What I work with</h2>
    <div class="skills-layout">
        <div class="skills-group reveal">
            <h3>Languages</h3>
            <% languages.forEach(lang => { %>
                <div class="skill-item">
                    <div class="skill-header">
                        <span><%= lang.name %></span>
                        <span><%= lang.level %></span>
                    </div>
                    <div class="skill-bar">
                        <div class="skill-fill" data-w="<%= lang.pct %>"></div>
                    </div>
                </div>
            <% }) %>
        </div>
        <div class="skills-group reveal">
            <h3>Libraries &amp; Tools</h3>
            <div class="chip-grid" style="margin-bottom:2rem;">
                <% tools.forEach(tool => { %>
                    <span class="chip"><%= tool %></span>
                <% }) %>
            </div>
            <h3>Concepts</h3>
            <div class="chip-grid">
                <% concepts.forEach(c => { %>
                    <span class="chip"><%= c %></span>
                <% }) %>
            </div>
        </div>
    </div>
</section>

<div class="divider"></div>

<!-- EXPERIENCE -->
<section id="experience">
    <p class="eyebrow reveal">Experience</p>
    <h2 class="sec-title reveal">My journey so far</h2>
    <div class="exp-list reveal">
        <% experience.forEach(exp => { %>
            <div class="exp-item">
                <div class="exp-date"><%= exp.date %></div>
                <div>
                    <div class="exp-role"><%= exp.role %></div>
                    <div class="exp-org"><%= exp.org %></div>
                    <ul class="exp-body">
                        <% exp.bullets.forEach(b => { %>
                            <li><%= b %></li>
                        <% }) %>
                    </ul>
                </div>
            </div>
        <% }) %>
    </div>
</section>

<div class="divider"></div>

<!-- CONTACT -->
<section id="contact">
    <p class="eyebrow reveal">Contact</p>
    <div class="contact-layout">
        <div class="reveal">
            <h2 class="contact-heading">Let's work on something <span>together.</span></h2>
            <p class="contact-sub">Open to internships, collaborations, game dev opportunities, or just a chat about code.</p>
            <div class="contact-links">
                <a href="mailto:<%= contact.email %>" class="clink">
                    <span class="clink-label">Email</span><%= contact.email %>
                </a>
                <a href="<%= contact.github %>" target="_blank" class="clink">
                    <span class="clink-label">GitHub</span><%= contact.github.replace('https://', '') %>
                </a>
                <a href="<%= contact.linkedin %>" target="_blank" class="clink">
                    <span class="clink-label">LinkedIn</span><%= contact.linkedin.replace('https://', '') %>
                </a>
            </div>
        </div>
        <form class="contact-form" action="/contact" method="POST">
            <div class="form-field">
                <label for="name">Name</label>
                <input id="name" name="name" type="text" placeholder="Your name" required />
            </div>
            <div class="form-field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" placeholder="your@email.com" required />
            </div>
            <div class="form-field">
                <label for="msg">Message</label>
                <textarea id="msg" name="message" placeholder="What's on your mind?"></textarea>
            </div>
            <% if (locals.success) { %>
                <p style="font-size:0.8rem;color:var(--accent2);">✓ Message sent!</p>
            <% } %>
            <button type="submit" class="btn" style="align-self:flex-start;cursor:pointer;">Send Message</button>
        </form>
    </div>
</section>

<%- include('partials/footer') %>

<script src="/js/main.js"></script>
</body>
</html>
